{
  "name": "@pattern-stack/wiring",
  "version": "0.1.0",
  "description": "Typed manifests and one flat composition, with no DI container: modules and systems declare what they need, compose builds them in dependency order, and start/stop run in that order and its reverse.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commands": {
      "bun": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^6.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
