{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Type-checks the tests too, which the build leaves out of dist.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*"]
}
