{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codegen.config.yaml",
  "description": "Project configuration for @pattern-stack/codegen. Generated from src/schema/codegen-config.schema.ts; do not edit.",
  "type": "object",
  "properties": {
    "runtime": {
      "default": "package",
      "type": "string",
      "enum": [
        "package",
        "vendored"
      ]
    },
    "target": {
      "default": {
        "database": "postgres",
        "orm": "drizzle"
      },
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "database": {
              "type": "string",
              "const": "postgres",
              "description": "PostgreSQL: pg-core column builders, node-postgres driver on Node"
            },
            "orm": {
              "type": "string",
              "const": "drizzle",
              "description": "Drizzle ORM: tables, columns and repositories written against drizzle-orm"
            },
            "wiring": {
              "description": "How the generated classes are composed (PW-3); default nest. Supported: { wiring: nest, http: nest }, { wiring: pattern-stack, http: none }.",
              "type": "string",
              "enum": [
                "nest",
                "pattern-stack"
              ]
            },
            "http": {
              "description": "The HTTP layer (PW-3); default follows wiring. Supported: { wiring: nest, http: nest }, { wiring: pattern-stack, http: none }.",
              "type": "string",
              "enum": [
                "nest",
                "none"
              ]
            }
          },
          "required": [
            "database",
            "orm"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "database": {
              "type": "string",
              "const": "sqlite",
              "description": "SQLite: sqlite-core column builders, ISO TEXT instants, TEXT + CHECK enums; storage layer only until wiring: pattern-stack"
            },
            "orm": {
              "type": "string",
              "const": "drizzle",
              "description": "Drizzle ORM: sqlite-core tables, plus SQLite DDL (.sql) from the same facts"
            },
            "wiring": {
              "description": "How the generated classes are composed (PW-3); default nest. Supported: { wiring: nest, http: nest }, { wiring: pattern-stack, http: none }.",
              "type": "string",
              "enum": [
                "nest",
                "pattern-stack"
              ]
            },
            "http": {
              "description": "The HTTP layer (PW-3); default follows wiring. Supported: { wiring: nest, http: nest }, { wiring: pattern-stack, http: none }.",
              "type": "string",
              "enum": [
                "nest",
                "none"
              ]
            }
          },
          "required": [
            "database",
            "orm"
          ],
          "additionalProperties": false
        }
      ]
    },
    "paths": {
      "default": {},
      "type": "object",
      "properties": {
        "backend_src": {
          "default": "src",
          "type": "string",
          "minLength": 1
        },
        "frontend_src": {
          "default": "apps/frontend/src",
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "default": "entities",
          "type": "string",
          "minLength": 1
        },
        "events_dir": {
          "default": "events",
          "type": "string",
          "minLength": 1
        },
        "jobs_dir": {
          "default": "definitions/jobs",
