          "minLength": 1
        },
        "providers": {
          "default": "definitions/providers",
          "type": "string",
          "minLength": 1
        },
        "modules_dir": {
          "type": "string",
          "minLength": 1
        },
        "orchestration_src": {
          "type": "string",
          "minLength": 1
        },
        "generated": {
          "type": "string",
          "minLength": 1
        }
