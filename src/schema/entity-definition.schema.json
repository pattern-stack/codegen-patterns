{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity Definition",
  "description": "Schema for entity YAML definitions. Defines domain entities with fields, relationships, behaviors, and layout options.",
  "type": "object",
  "properties": {
    "entity": {
      "description": "Entity configuration",
      "type": "object",
      "properties": {
        "name": {
          "description": "Entity name in snake_case (e.g., 'opportunity')",
          "type": "string"
        },
        "plural": {
          "description": "Plural form in snake_case (e.g., 'opportunities')",
          "type": "string"
        },
        "table": {
          "description": "Literal SQL table name, used verbatim (default: <tables.prefix><plural>)",
          "type": "string"
        },
        "table_prefix": {
          "description": "Overrides the project's tables.prefix for this table; '' opts out. Exclusive with table",
          "type": "string"
        },
        "expose": {
          "description": "Which layers to generate",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "repository",
              "rest",
              "trpc"
            ]
          }
        }
      },
      "required": [
        "name",
        "plural"
      ]
    },
    "fields": {
      "description": "Field definitions",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Field data type",
            "type": "string",
            "enum": [
              "string",
              "integer",
              "decimal",
              "boolean",
              "uuid",
              "date",
              "datetime",
              "json",
              "entity_ref",
              "string_array",
              "enum"
            ]
          },
          "required": {
            "description": "Field must be provided on CREATE",
            "type": "boolean"
          },
          "timezone": {
            "description": "type: datetime only. Default: timestamp with time zone. false: wall-clock timestamp without time zone (read through the Date UTC fields)",
            "type": "boolean"
          },
          "nullable": {
            "description": "Database column allows NULL. Undeclared: NULL unless required: true; a belongs_to foreign key is NOT NULL unless nullable: true. false (without required: true) needs a default:",
            "type": "boolean"
          },
          "max_length": {
            "description": "Max string length",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "min_length": {
            "description": "Min string length",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "min": {
            "description": "Minimum numeric value",
            "type": "number"
          },
          "max": {
            "description": "Maximum numeric value",
            "type": "number"
          },
          "choices": {
            "description": "Enum values for this field",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "choices_from": {
            "description": "Load enum values from external YAML file",
            "type": "string"
          },
          "choices_of": {
            "description": "'<entity>.<field>': this enum is the same Postgres type as that entity's enum field (RFC-0006)",
            "type": "string"
          },
          "allowed_types": {
            "description": "Allowed entity types for entity_ref",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {
            "description": "Default value"
          },
          "index": {
            "description": "Create database index",
            "type": "boolean"
          },
          "unique": {
            "description": "Unique constraint",
            "type": "boolean"
          },
          "foreign_key": {
            "description": "Foreign key reference (e.g., 'accounts.id')",
            "type": "string"
          },
          "ui_label": {
            "description": "Display label",
            "type": "string"
          },
          "ui_type": {
            "description": "UI input type",
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "money",
              "percentage",
              "email",
              "url",
              "date",
              "datetime",
              "boolean",
              "enum",
              "reference",
              "json",
              "badge",
              "password"
            ]
          },
          "ui_importance": {
            "description": "Field importance for display",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "tertiary"
            ]
          },
          "ui_group": {
            "description": "UI grouping",
            "type": "string"
          },
          "ui_sortable": {
            "description": "Allow sorting by this field",
            "type": "boolean"
          },
          "ui_filterable": {
            "description": "Allow filtering by this field",
            "type": "boolean"
          },
          "ui_visible": {
            "description": "Show in UI by default",
            "type": "boolean"
          },
          "ui_placeholder": {
            "description": "Input placeholder text",
            "type": "string"
          },
          "ui_help": {
            "description": "Help text",
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "relationships": {
      "description": "Entity relationships",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Relationship type",
            "type": "string",
            "enum": [
              "belongs_to",
              "has_many",
              "has_one"
            ]
          },
          "target": {
            "description": "Target entity name (e.g., 'account')",
            "type": "string"
          },
          "foreign_key": {
            "description": "FK field name (e.g., 'account_id')",
            "type": "string"
          },
          "match": {
            "description": "belongs_to only: composite FK. { <local column>: <target column> }, or a list of names as shorthand for same-name pairs (RFC-0006)",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "type",
          "target",
          "foreign_key"
        ]
      }
    },
    "behaviors": {
      "description": "Cross-cutting behaviors",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "description": "Adds created_at, updated_at",
            "type": "string",
            "const": "timestamps"
          },
          {
            "description": "Adds deleted_at for soft deletes",
            "type": "string",
            "const": "soft_delete"
          },
          {
            "description": "Adds created_by, updated_by",
            "type": "string",
            "const": "user_tracking"
          },
          {
            "description": "Adds valid_from, valid_to, is_active",
            "type": "string",
            "const": "temporal_validity"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "description": "Behavior name",
                "type": "string"
              },
              "options": {
                "description": "Behavior options",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "inherits": {
      "description": "Child of a joined-table family: '<base entity>', or { base, as } when the kind value is not the entity name (RFC-0006)",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "base": {
              "type": "string"
            },
            "as": {
              "type": "string"
            }
          },
          "required": [
            "base"
          ]
        }
      ]
    },
    "discriminator": {
      "description": "Base of a joined-table family: the enum field that holds each row's kind (RFC-0006)",
      "type": "string"
    },
    "unique_indexes": {
      "description": "Unique constraints: 1+ fields, optional where (partial) and nulls_not_distinct",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fields": {
            "description": "Columns the unique constraint spans (1+)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "description": "Constraint name, lowercase snake_case, max 63 (default <table>_<col1>_<col2>_uniq); required with `where`",
            "type": "string"
          },
          "where": {
            "description": "Raw SQL predicate making this a partial unique index; needs `name`, exclusive with nulls_not_distinct: true",
            "type": "string"
          },
          "natural_key": {
            "description": "The ON CONFLICT target of the pair upsert. At most one per entity; every column NOT NULL; a child declares none (RFC-0006 R11)",
            "type": "boolean"
          },
          "nulls_not_distinct": {
            "description": "true: UNIQUE NULLS NOT DISTINCT constraint. Default on tenant_scoped entities; false opts out. PostgreSQL 15+",
            "type": "boolean"
          }
        },
        "required": [
          "fields"
        ]
      }
    }
  },
  "required": [
    "entity",
    "fields"
  ]
}