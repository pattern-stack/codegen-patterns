                "type": "string",
                "const": "webhook"
              },
              "webhook": {
                "type": "object",
                "properties": {
                  "eventIdField": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "mapping": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "transform": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "source",
                    "target"
                  ]
                }
              },
              "filters": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "neq",
                        "in",
                        "nin",
                        "gt",
                        "gte",
                        "lt",
