                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "timestamp"
                          },
                          "field": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "field"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
