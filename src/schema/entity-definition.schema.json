            ]
          }
        ]
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "electric": {
          "default": false,
          "type": "boolean"
        },
        "providers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "remote_entity": {
                "type": "string"
              },
