{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity Definition",
  "description": "Schema for entity YAML definitions. Generated from src/schema/entity-definition.schema.ts; do not edit.",
  "type": "object",
  "properties": {
    "entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Entity name in snake_case (e.g., 'opportunity')"
        },
        "plural": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Plural form in snake_case (e.g., 'opportunities')"
        },
        "table": {
          "description": "Literal SQL table name, used verbatim (default: <tables.prefix><plural>)",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "table_name": {
          "not": {}
        },
        "table_prefix": {
          "description": "Overrides the project's tables.prefix for this table; '' opts out. Exclusive with table",
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*)?$"
        },
        "expose": {
          "default": [
            "repository",
            "rest",
            "trpc"
          ],
          "description": "Which layers to generate",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "repository",
              "rest",
              "trpc",
              "electric"
            ]
          }
        },
        "pattern": {
          "type": "string"
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "scopeable": {
          "not": {}
        },
        "surface": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "sync": {
          "type": "string",
          "enum": [
            "api",
            "electric"
          ]
        }
      },
      "required": [
        "name",
        "plural"
      ],
      "additionalProperties": false,
      "description": "Entity configuration"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "decimal",
              "boolean",
              "uuid",
              "date",
              "datetime",
              "json",
              "entity_ref",
              "string_array",
              "enum"
            ],
            "description": "Field data type"
          },
          "required": {
            "description": "Field must be provided on CREATE",
            "type": "boolean"
          },
          "nullable": {
            "description": "Database column allows NULL. Undeclared: NULL unless required: true; a belongs_to foreign key is NOT NULL unless nullable: true. false (without required: true) needs a default:",
            "type": "boolean"
          },
          "timezone": {
            "description": "type: datetime only. Default: timestamp with time zone. false: wall-clock timestamp without time zone (read through the Date UTC fields)",
            "type": "boolean"
          },
          "max_length": {
            "description": "Max string length",
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "min_length": {
            "description": "Min string length",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "min": {
            "description": "Minimum numeric value",
            "type": "number"
          },
          "max": {
            "description": "Maximum numeric value",
            "type": "number"
          },
          "choices": {
            "description": "Enum values for this field",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "choices_from": {
            "description": "Load enum values from external YAML file",
            "type": "string"
          },
          "choices_of": {
            "description": "'<entity>.<field>': this enum is the same Postgres type as that entity's enum field (RFC-0006)",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          },
          "allowed_types": {
            "description": "Allowed entity types for entity_ref",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {
            "description": "Default value"
          },
          "example": {
            "description": "Example value for the API docs (Swagger 'Try it out' prefill); must be a value this field accepts"
          },
          "index": {
            "description": "Create database index",
            "type": "boolean"
          },
          "unique": {
            "description": "Unique constraint",
            "type": "boolean"
          },
          "foreign_key": {
            "description": "Foreign key reference (e.g., 'accounts.id')",
            "type": "string"
          },
          "ui_label": {
            "description": "Display label",
            "type": "string"
          },
          "ui_type": {
            "description": "UI input type",
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "money",
              "percentage",
              "email",
              "url",
              "date",
              "datetime",
              "boolean",
              "enum",
              "reference",
              "json",
              "badge",
              "password"
            ]
          },
          "ui_importance": {
            "description": "Field importance for display",
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "tertiary"
            ]
          },
          "ui_group": {
            "description": "UI grouping",
            "type": "string"
          },
          "ui_sortable": {
            "description": "Allow sorting by this field",
            "type": "boolean"
          },
          "ui_filterable": {
            "description": "Allow filtering by this field",
            "type": "boolean"
          },
          "ui_visible": {
            "description": "Show in UI by default",
            "type": "boolean"
          },
          "ui_placeholder": {
            "description": "Input placeholder text",
            "type": "string"
          },
          "ui_help": {
            "description": "Help text",
            "type": "string"
          },
          "ui_format": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "ui_key_field": {
            "type": "boolean"
          },
          "ui_key_field_order": {
            "type": "number"
          },
          "role": {
            "type": "string",
            "enum": [
              "measure",
              "dimension"
            ]
          },
          "agg": {
            "type": "string",
            "enum": [
              "count",
              "count_distinct",
              "sum",
              "avg",
              "min",
              "max"
            ]
          },
          "aggs": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "count",
                "count_distinct",
                "sum",
                "avg",
                "min",
                "max"
              ]
            }
          },
          "additivity": {
            "type": "string",
            "enum": [
              "additive",
              "semi",
              "non"
            ]
          },
          "time": {
            "type": "boolean"
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "description": "Field definitions"
    },
    "relationships": {
      "description": "Entity relationships",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "belongs_to",
              "has_many",
              "has_one"
            ],
            "description": "Relationship type"
          },
          "target": {
            "type": "string",
            "description": "Target entity name (e.g., 'account')"
          },
          "foreign_key": {
            "type": "string",
            "description": "FK field name (e.g., 'account_id')"
          },
          "through": {
            "type": "string"
          },
          "inverse": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "on_delete": {
            "default": "restrict",
            "type": "string",
            "enum": [
              "restrict",
              "cascade",
              "set_null",
              "no_action"
            ]
          },
          "match": {
            "description": "belongs_to only: composite FK. { <local column>: <target column> }, or a list of names as shorthand for same-name pairs (RFC-0006)",
            "anyOf": [
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "required": [
          "type",
          "target",
          "foreign_key"
        ],
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "cardinality": {
            "type": "string",
            "enum": [
              "one",
              "many"
            ]
          },
          "column": {
            "type": "string"
          },
          "via": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "on_delete": {
            "type": "string",
            "enum": [
              "restrict",
              "cascade",
              "set_null",
              "no_action"
            ]
          }
        },
        "required": [
          "target",
          "cardinality"
        ],
        "additionalProperties": false
      }
    },
    "behaviors": {
      "default": [],
      "description": "Cross-cutting behaviors",
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "anyOf": [
              {
                "const": "timestamps",
                "description": "Adds created_at and updated_at timestamp fields"
              },
              {
                "const": "soft_delete",
                "description": "Adds deleted_at field for soft delete functionality"
              },
              {
                "const": "user_tracking",
                "description": "Adds created_by and updated_by user reference fields"
              },
              {
                "const": "external_id_tracking",
                "description": "Adds external_id, provider, and provider_metadata fields for external system sync tracking"
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "description": "Behavior name",
                "type": "string",
                "anyOf": [
                  {
                    "const": "timestamps",
                    "description": "Adds created_at and updated_at timestamp fields"
                  },
                  {
                    "const": "soft_delete",
                    "description": "Adds deleted_at field for soft delete functionality"
                  },
                  {
                    "const": "user_tracking",
                    "description": "Adds created_by and updated_by user reference fields"
                  },
                  {
                    "const": "external_id_tracking",
                    "description": "Adds external_id, provider, and provider_metadata fields for external system sync tracking"
                  }
                ]
              },
              "options": {
                "description": "Behavior options",
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "name"
            ]
          }
        ]
      }
    },
    "inherits": {
      "description": "Child of a joined-table family: '<base entity>', or { base, as } when the kind value is not the entity name (RFC-0006)",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        {
          "type": "object",
          "properties": {
            "base": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "as": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "base"
          ],
          "additionalProperties": false
        }
      ]
    },
    "discriminator": {
      "description": "Base of a joined-table family: the enum field that holds each row's kind (RFC-0006)",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "generate": {
      "type": "object",
      "properties": {
        "writes": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "api": {
      "default": true,
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "includes": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "max_depth": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "paths": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "max_depth",
                  "paths"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "eav": {
      "default": false,
      "type": "boolean"
    },
    "eav_value_table": {
      "default": false,
      "type": "boolean"
    },
    "eav_definition_table": {
      "type": "string"
    },
    "queries": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "const": "search"
              },
              "filters": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "search": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "filters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "by": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unique": {
                "type": "boolean"
              },
              "select": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "string"
              },
              "limit": {
                "type": "boolean"
              },
              "via": {
                "type": "string"
              }
            },
            "required": [
