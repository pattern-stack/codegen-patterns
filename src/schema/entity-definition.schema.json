                          "kind",
                          "field"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "syncToken"
                          },
                          "field": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
