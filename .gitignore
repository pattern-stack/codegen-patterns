# Dependencies
node_modules/

# Lockfiles (regenerated on install)
bun.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
*.tsbuildinfo

# Test output (regenerated)
test/gen/

# Codegen output (generated from entity YAML — never commit).
# ANCHORED to the repo root (leading `/`): unanchored patterns match at every
# depth, so a bare `generated/` would also swallow `src/generated/`,
# `runtime/subsystems/*/generated/` (committed — see below) and
# `packages/graph-components/src/generated/`, and a bare `shared/` would swallow
# `src/cli/shared/`, `runtime/shared/` and `test/scaffold/shared/` (GATE-1, #599).
/gen/
/app/
/apps/
/modules/
# `just test-integration` generates the scaffold consumer into the repo root
# (the scaffold's `@gen/*` alias maps there). Its teardown removes these; the
# entries are a safety net for an interrupted run.
/generated/
/shared/

# Codegen output packages (not our source packages).
# packages/graph-components/ is real source; everything else under
# packages/ is generated by `bun test/run-test.ts generate` from the
# fixtures in test/fixtures/ and must not be committed.
packages/api/
packages/db/
# `runtime/subsystems/jobs/generated/` is a per-run codegen artifact
# too (schema.single-tenant.ts + schema.multi-tenant.ts variants).
# The other files under `runtime/subsystems/*/generated/` (e.g.
# `events/generated/bus.ts`) ARE committed — they ship in the runtime
# module that consumers consume.
runtime/subsystems/jobs/generated/

# Runtime artifacts
agent-logs/
codegen.config.yaml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dev companion
.dev-app.pid
.dev-app.log

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Unit-test tmp dirs (emit-typecheck fixtures, etc.)
test/tmp/

# Claude Code local session/worktree state (not project artifacts)
.claude/.session/
.claude/worktrees/

# `just studio-demo` writes a real generated project here.
.studio-demo/
