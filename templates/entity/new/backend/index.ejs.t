---
to: "<%= outputPaths.index %>"
force: true
---
<%- generatedBanner %>
/**
 * <%= classNames.entity %> module barrel export
 * Generated by entity codegen - do not edit directly
 */

<% if (plainWiring) { -%>
// Value exports (repository, service; PW-3: no Nest module or controller under wiring: plain)
export { <%= classNames.repository %> } from './<%= entityFileStem %>.repository';
export { <%= classNames.service %> } from './<%= entityFileStem %>.service';
<% } else { -%>
// Value exports (module, service<% if (apiSurface.http.enabled) { %>, controller<% } %>)
export { <%= classNames.module %> } from './<%= entityPluralFileStem %>.module';
export { <%= classNames.service %> } from './<%= entityFileStem %>.service';
<% if (apiSurface.http.enabled) { -%>
export { <%= classNames.controller %> } from './<%= entityFileStem %>.controller';
<% } -%>
<% } -%>

// Type-only exports (entity, DTOs)
export type { <%= classNames.entity %> } from './<%= entityFileStem %>.entity';
export type { <%= classNames.createDto %> } from './dto/create-<%= entityFileStem %>.dto';
export type { <%= classNames.updateDto %> } from './dto/update-<%= entityFileStem %>.dto';
export type { <%= classNames.outputDto %> } from './dto/<%= outputDtoStem %>.dto';
<% if (outputPaths.ofKindDto) { -%>
export type { <%= classNames.ofKindDto %> } from './dto/<%= ofKindDtoStem %>.dto';
<% } -%>
export type { <%= classNames.listQueryDto %> } from './dto/list-<%= entityPluralFileStem %>.query';
