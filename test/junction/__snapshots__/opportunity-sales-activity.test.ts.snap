    endedAt: timestamp('ended_at'),

    // Provenance (sourced: true, default)
    sourcedFrom: text('sourced_from'),
    confidence: numeric('confidence', { precision: 5, scale: 4 }),
    matchedAt: timestamp('matched_at'),

    // Timestamps
    createdAt: timestamp('created_at').notNull().defaultNow(),
    updatedAt: timestamp('updated_at').notNull().defaultNow(),
  },
  (table) => [
    // Composite primary key on the two FK columns (Q4 resolution: no surrogate id)
    primaryKey({ columns: [table.opportunityId, table.salesActivityId] }),
  ],
);

export type OpportunitySalesActivity = InferSelectModel<typeof opportunitySalesActivities>;
export type OpportunitySalesActivityInsert = typeof opportunitySalesActivities.$inferInsert;
