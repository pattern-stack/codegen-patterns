  // ═══════════════════════════════════════════════════════════════════════
  // Junction fan-out (CGP-60)
  // Delegates to each junction's service; the same association is mirrored
  // on the other parent.
  // ═══════════════════════════════════════════════════════════════════════

  // opportunity_sales_activity — left side, fan-out to SalesActivity
  @Inject(forwardRef(() => OpportunitySalesActivityService))
  private readonly opportunitySalesActivityService!: OpportunitySalesActivityService;

  async attachSalesActivity(
    opportunityId: string,
    salesActivityId: string,
    link?: OpportunitySalesActivityLinkInput,
  ): Promise<OpportunitySalesActivity> {
    return this.opportunitySalesActivityService.attach(opportunityId, salesActivityId, link);
  }

  async detachSalesActivity(
    opportunityId: string,
    salesActivityId: string,
  ): Promise<void> {
    return this.opportunitySalesActivityService.detach(opportunityId, salesActivityId);
  }

  async sales_activitiesList(
    opportunityId: string,
    opts?: { cursor?: string; limit?: number },
  ): Promise<Array<{ entity: SalesActivity; link: OpportunitySalesActivity }>> {
    return this.opportunitySalesActivityService.listAssoc('left', opportunityId, opts) as Promise<
      Array<{ entity: SalesActivity; link: OpportunitySalesActivity }>
    >;
  }

  async sales_activitiesSetPrimary(
    opportunityId: string,
    salesActivityId: string,
  ): Promise<void> {
    return this.opportunitySalesActivityService.setPrimary(opportunityId, salesActivityId);
  }
}
"
